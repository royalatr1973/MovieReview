{
  "name": "moviereview",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace=apps/server",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "shared:build": "npm run build --workspace=packages/shared",
    "admin:dev": "npm run dev --workspace=apps/admin",
    "test": "npm run test --workspaces --if-present",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
